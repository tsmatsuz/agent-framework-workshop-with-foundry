# Microsoft Foundry Project Endpoint
# Format: https://[FOUNDRY-RESOURCE-NAME].services.ai.azure.com/api/projects/[PROJECT-NAME]
# Find this in: Azure Portal → Foundry Project → Overview, or Foundry Portal dashboard
# ⚠️ NOT the Azure OpenAI endpoint (openai.azure.com) - must be Foundry project endpoint
AZURE_AI_PROJECT_ENDPOINT="https://your-foundry.services.ai.azure.com/api/projects/your-project"

# Model deployment name (must be deployed in your Foundry project)
# Supported models: gpt-4o, gpt-4o-mini, gpt-4.1, etc. (Responses API compatible)
# See: https://learn.microsoft.com/en-us/azure/ai-foundry/openai/how-to/responses
AZURE_AI_MODEL_DEPLOYMENT_NAME="gpt-4o"
